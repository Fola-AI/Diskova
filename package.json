{
  "name": "diskova-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node scripts/run-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "next build && next lint && tsc --noEmit && vitest run && node scripts/run-smoke.mjs",
    "icons": "dotenv -e .env.local -- tsx scripts/generate-icons.ts",
    "sentry:test": "dotenv -e .env.local -- tsx scripts/sentry-test.ts",
    "db:push": "dotenv -e .env.local -- node scripts/dev-db.mjs push",
    "db:seed": "dotenv -e .env.local -- node scripts/dev-db.mjs seed",
    "db:types": "dotenv -e .env.local -- node scripts/dev-db.mjs types",
    "create-super-admin": "dotenv -e .env.local -- tsx scripts/create-super-admin.ts",
    "db:samples": "dotenv -e .env.local -- node scripts/dev-db.mjs samples"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-slot": "1.4.0",
    "@react-email/components": "1.0.12",
    "@sentry/nextjs": "11.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/og": "1.0.3",
    "@vercel/speed-insights": "2.0.0",
    "blurhash": "2.0.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "isomorphic-dompurify": "4.5.0",
    "lucide-react": "1.52.0",
    "mapbox-gl": "3.32.0",
    "nanoid": "6.0.2",
    "next": "15.5.27",
    "next-themes": "0.4.6",
    "openai": "7.30.0",
    "qrcode": "1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.89.0",
    "react-map-gl": "8.1.3",
    "resend": "6.32.1",
    "sharp": "0.35.5",
    "slugify": "1.6.9",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "supabase": "2.120.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "next": {
      "postcss": "8.5.29"
    },
    "fflate": "0.7.5"
  }
}
